# Copy to .env and adjust. Never commit .env.

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL connection (used by pg Pool)
# Example local: postgresql://postgres:postgres@localhost:5432/campaign_manager
# With repo-root `docker compose up`, use host port 5432: postgresql://postgres:postgres@127.0.0.1:5432/campaign_manager
# If migrate fails with "database does not exist" (3D000), run: npm run db:create
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# JWT (use a long random string in production; HS256)
JWT_SECRET=change-me-to-at-least-32-chars-in-prod-please
JWT_EXPIRES_IN=7d

# CORS: exact origin for the SPA, or * for local dev only
CORS_ORIGIN=http://localhost:5173

# httpOnly session cookie (FE: credentials: 'include')
COOKIE_NAME=access_token
