# Absolute URL to CampaignManagerAPI (include port). Must match API CORS allowlist when using cookies.
# Docker Compose API: http://localhost:8000
# Local yarn dev:api: http://localhost:3000
VITE_API_URL=http://localhost:8000

# Optional: max recipients per campaign (align with API MAX_RECIPIENTS_PER_CAMPAIGN)
VITE_MAX_RECIPIENTS_PER_CAMPAIGN=10000
